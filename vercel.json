{
  "rewrites": [
    {
      "source": "/api/neon-auth/:path*",
      "destination": "/api/neon-auth-router?path=:path*"
    },
    {
      "source": "/api/loyalty/:route*",
      "destination": "/api/loyalty-router?route=:route*"
    },
    {
      "source": "/rewards",
      "destination": "/index.html"
    },
    {
      "source": "/admin/rewards",
      "destination": "/index.html"
    }
  ]
}